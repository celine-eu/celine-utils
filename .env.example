
# Keycloak — client credentials, used by `governance generate marquez` to obtain a
# token when Marquez requires authentication. Leave the client id/secret empty to
# call Marquez unauthenticated.
KEYCLOAK_URL=http://keycloak.celine.localhost:8080
# Note: some kc version may need a /auth/ suffix to work
# KEYCLOAK_URL=http://keycloak.celine.localhost:8080/auth/

KEYCLOAK_REALM=celine
KEYCLOAK_CLIENT_ID=celine-cli
KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_VERIFY=true

LOG_LEVEL=info
CELINE_LOG_LEVEL=info

POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=securepassword123
POSTGRES_DB=datasets

# MQTT Pipeline Events
MQTT_EVENTS_ENABLED=true

# MQTT Broker (via celine-sdk)
CELINE_MQTT_HOST=host.docker.internal
CELINE_MQTT_PORT=1883
CELINE_MQTT_USE_TLS=false

# OIDC Authentication (optional - for JWT auth to broker)
CELINE_OIDC_BASE_URL=http://keycloak.celine.localhost/realms/celine
CELINE_OIDC_CLIENT_ID=celine-cli
CELINE_OIDC_CLIENT_SECRET=celine-cli
